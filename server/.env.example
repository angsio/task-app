# Copy to .env and fill in. Nothing here has a working default.
# docker-compose.yml overrides AUTH_URL and ALLOWED_ORIGINS in production, so
# this file can stay on its development values.

PORT=5001

# MongoDB Atlas connection string. The database name is set in code, not here.
MONGODB_URI=

# The auth service. Container name in production, localhost in development.
AUTH_URL=http://localhost:5002

# Comma-separated. The browser origins allowed to call this server.
ALLOWED_ORIGINS=http://localhost:5173

# Supabase project holding the tool_embeddings table and the match_tools RPC.
# The secret key is server-side only and bypasses row level security.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# The chat and embedding endpoints, and the bearer token for both.
AWS_MODELS_TOKEN=
CHAT_URL=
EMBED_URL=


# ---- metrics ----------------------------------------------------------------
# server/metrics/README.md explains what each of these changes.

# Required before recording anything. Any random string; 32 hex characters is a
# reasonable choice. Account IDs are hashed with it, so changing it later
# renames every account in the data and breaks joins across the change.
METRICS_SALT=

# Rates for the chat model, per million tokens. Leave empty and the report says
# "not priced" rather than inventing a figure.
METRICS_PRICE_IN_PER_MTOK=
METRICS_PRICE_OUT_PER_MTOK=

# Rate for the embedding model, per million tokens. Embedding models bill input
# only: a vector is not tokens, so there is no output rate.
METRICS_PRICE_EMBED_PER_MTOK=

# Optional, shown with their defaults.
# METRICS_ENABLED=1              # 0 turns recording off entirely
# METRICS_DIR=                   # defaults to server/metrics/data
# METRICS_RETAIN_DAYS=30         # day files older than this are pruned
# METRICS_LOG_CONTENT=0          # 1 also records prompts and tool arguments

# Optional, evaluation only.
# EVAL_K=1,2,3,5                 # the k values the sweep reports
# EVAL_MIN_SIMILARITY=0.13       # must match MIN_SIMILARITY in agent/tools/findTools.js
